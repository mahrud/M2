From e68bc088aefdd6d36172fa4cfb090de7874f8edf Mon Sep 17 00:00:00 2001
From: Mahrud Sayrafi <mahrud@berkeley.edu>
Date: Sat, 21 Mar 2026 10:23:47 -0400
Subject: [PATCH] added --M2 option to barvinok_enumerate for printing chamber
 and polynomial

---
 evalue_convert.cc        | 38 ++++++++++++++++++++++++++++++++++++++
 evalue_convert.h         |  1 +
 evalue_convert_options.c |  1 +
 3 files changed, 40 insertions(+)

diff --git a/evalue_convert.cc b/evalue_convert.cc
index 07c39fa..1bf82b6 100644
--- a/evalue_convert.cc
+++ barvinok-0.41.8/evalue_convert.cc
@@ -382,6 +382,41 @@ static void evalue_print_isl(FILE *out, const evalue *e, int nparam,
 	isl_ctx_free(ctx);
 }
 
+static void evalue_print_m2(FILE *out, const evalue *e, int nparam,
+			      const char **params)
+{
+	if (value_zero_p(e->d) && e->x.p->type == partition) {
+		int npiece = e->x.p->size / 2;
+		isl_ctx *ctx = isl_ctx_alloc();
+		isl_space *dim = isl_space_set_alloc(ctx, nparam, 0);
+		isl_printer *p;
+
+		for (int j = 0; j < nparam; ++j)
+			dim = isl_space_set_dim_name(dim, isl_dim_param, j, params[j]);
+
+		fprintf(out, "%d\n", npiece);
+		p = isl_printer_to_file(ctx, out);
+		for (int i = 0; i < npiece; ++i) {
+			isl_qpolynomial *qp;
+
+			fprintf(out, "\n");
+			Polyhedron_PrintConstraints(out, P_VALUE_FMT,
+				EVALUE_DOMAIN(e->x.p->arr[2 * i]));
+			qp = isl_qpolynomial_from_evalue(isl_space_copy(dim),
+					&e->x.p->arr[2 * i + 1]);
+			p = isl_printer_print_qpolynomial(p, qp);
+			p = isl_printer_end_line(p);
+			isl_qpolynomial_free(qp);
+		}
+		isl_printer_free(p);
+		isl_space_free(dim);
+		isl_ctx_free(ctx);
+		return;
+	}
+
+	evalue_print_isl(out, e, nparam, params);
+}
+
 int evalue_convert(evalue *EP, struct convert_options *options,
 		   int verbose, unsigned nparam, const char **params)
 {
@@ -405,6 +440,9 @@ int evalue_convert(evalue *EP, struct convert_options *options,
     } else if (options->latex && params) {
 	evalue_print_latex(stdout, EP, nparam, params);
 	printed = 1;
+    } else if (options->m2 && params) {
+	evalue_print_m2(stdout, EP, nparam, params);
+	printed = 1;
     } else if (options->isl && params) {
 	evalue_print_isl(stdout, EP, nparam, params);
 	printed = 1;
diff --git a/evalue_convert.h b/evalue_convert.h
index 999f472..a204992 100644
--- a/evalue_convert.h
+++ barvinok-0.41.8/evalue_convert.h
@@ -16,6 +16,7 @@ struct convert_options {
     int list;
     int latex;
     int isl;
+    int m2;
 };
 
 int evalue_convert(evalue *EP, struct convert_options *options,
diff --git a/evalue_convert_options.c b/evalue_convert_options.c
index f0db5fd..77f5d0f 100644
--- a/evalue_convert_options.c
+++ barvinok-0.41.8/evalue_convert_options.c
@@ -10,4 +10,5 @@ ISL_ARG_BOOL(struct convert_options, floor, 'f', "floor", 0,
 ISL_ARG_BOOL(struct convert_options, list, 'l', "list", 0, NULL)
 ISL_ARG_BOOL(struct convert_options, latex, 'L', "latex", 0, NULL)
 ISL_ARG_BOOL(struct convert_options, isl, 'I', "to-isl", 0, NULL)
+ISL_ARG_BOOL(struct convert_options, m2, 0, "M2", 0, NULL)
 ISL_ARGS_END
